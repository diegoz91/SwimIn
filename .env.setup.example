# Copia questo file in .env.setup (NON va mai committato).
# Serve solo agli script Node (npm run setup-db / reset-db) che usano una API key con permessi di amministrazione.
# Crea la key in Appwrite Console → Overview → Integrations → API keys.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=il-tuo-project-id
APPWRITE_API_KEY=la-tua-api-key

# Facoltativi
# Indirizzo pubblico dell'app (link nelle email e identità delle notifiche push).
# APP_URL=https://il-tuo-dominio.it
# Email di notifica: metti "on" dopo aver configurato un provider in Appwrite → Messaging (Brevo, Mailgun, SMTP…).
EMAIL_NOTIFICATIONS=off
# Le chiavi VAPID per le push vengono generate da setup-db e salvate nella Function: non servono qui.

# SwimIn Premium (facoltativo): con queste chiavi setup-db crea prezzi/piani e webhook.
# Indirizzo della Function api (Console Appwrite → Functions → api → Domains), es. https://xxxx.fra.appwrite.run
# FUNCTION_URL=
# Stripe → Developers → API keys (sk_test_… per le prove, sk_live_… in produzione)
# STRIPE_SECRET_KEY=
# PayPal Developer → Apps & Credentials (sandbox per le prove, live in produzione)
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_MODE=sandbox
